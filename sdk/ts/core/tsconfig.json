{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    // Generated transport (@hey-api/openapi-ts output) is not written to this
    // strictness; the hand-written @firemoot/client keeps it on.
