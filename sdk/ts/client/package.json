{
  "name": "@firemoot/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hand-written Firemoot client: connection lifecycle, auto-reconnect with seq resume, Channel state, typed events (see PLAN.md M4.1).",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@firemoot/core": "workspace:*"
  }
}
